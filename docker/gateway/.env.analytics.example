# Integração desligada por padrão. Só ativar no gateway de produção após
# revisar/aplicar a migration e configurar o token do projeto PostHog 633289.
POSTHOG_GATEWAY_ENVIRONMENT=disabled
POSTHOG_PROJECT_TOKEN=
POSTHOG_REGION=us
# Orçamento persistido, compartilhado entre réplicas; teto aceito = 200000.
# Não inclui eventos do site nem substitui o limite global do PostHog.
POSTHOG_GATEWAY_MONTHLY_EVENT_LIMIT=200000
